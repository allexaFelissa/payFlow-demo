# Copy this file to .env.testing. Never point it at development or production.
APP_ENV=testing
APP_KEY=

DB_CONNECTION=pgsql_testing
# Neon testing branch Direct connection string.
TEST_DB_URL=
# Set true only after confirming this is a disposable, isolated testing branch.
TEST_DB_ISOLATED=false

# Use these discrete values only when TEST_DB_URL is empty.
TEST_DB_HOST=
TEST_DB_PORT=5432
TEST_DB_DATABASE=
TEST_DB_USERNAME=
TEST_DB_PASSWORD=
TEST_DB_CHARSET=utf8
TEST_DB_SSLMODE=require

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
