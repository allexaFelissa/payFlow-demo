# Copy this file to .env for the Docker Compose deployment.
# Never commit or place the populated .env inside an unencrypted project archive.
APP_NAME="PayFlow HR"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The application is initially available here. Tailscale supplies the private
# HTTPS URL without requiring a public domain or certificate in this container.
APP_URL=http://127.0.0.1:8000
ASSET_URL=
FRONTEND_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
# Neon production branch pooled connection string. DB_URL takes precedence.
DB_URL=
# Optional Neon direct connection string used only for automatic migrations.
# If omitted, migrations use DB_URL.
DB_MIGRATION_URL=
# Use these discrete values only when DB_URL is empty.
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8
DB_SSLMODE=require

CACHE_STORE=database
CACHE_PREFIX=payflow-production-cache-

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# The current application dispatches no asynchronous jobs.
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=database-uuids

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS=payroll@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Optional SMTP configuration (required only when MAIL_MAILER=smtp).
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional S3-compatible storage (requires the Flysystem S3 adapter before use).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional build-time override. Leave blank for the recommended same-origin /api.
VITE_API_URL=
